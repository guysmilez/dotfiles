# Path...
export PATH="/opt/homebrew/opt/curl/bin:$PATH" # Custom curl...
export PATH="$(brew --prefix php)/bin:$PATH" # Add Homebrew PHP
export PATH="/opt/homebrew/opt/php@8.3/bin:$PATH"
export PATH="$HOME/.composer/vendor/bin:$PATH" # Add Composer bin
export PATH="vendor/bin:$PATH" # Add local project Composer bin
export PATH="/opt/homebrew/opt/node@14/bin:$PATH" # Add node 14 locally
export PATH="./node_modules/.bin:$PATH" # Add Node modules local bin
export PATH="$PATH:$HOME/go/bin" # Golang bin
export PATH="$PATH:$HOME/.rbenv/bin" # rbenv bin for Ruby
export PATH="$PATH:$HOME/Code/dotfiles/bin" # Local files
export PATH="$HOME/Code/bin:$PATH"
export PATH="$HOME/bin:$PATH"
export PATH="/opt/homebrew/opt/gnu-sed/libexec/gnubin:$PATH"
export PATH="/opt/homebrew/opt/mysql-client/bin:$PATH"
export PATH=/Users/markhorlbeck/.grok/bin:$PATH
export PATH="$HOME/.rustup/toolchains/stable-aarch64-apple-darwin/bin:$PATH"

# Xdebug...
export XDEBUG_CONFIG="idekey=VSCODE"

# Editor...
export EDITOR="/usr/local/bin/code -w -n"

# Terminal...
export TERM="xterm-256color"

# Prefer US English and use UTF-8...
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# Always enable colored `grep` output...
export GREP_OPTIONS="--color=auto"

export BAT_THEME="1337"
